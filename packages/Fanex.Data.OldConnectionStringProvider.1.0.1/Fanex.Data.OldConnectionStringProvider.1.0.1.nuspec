<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Fanex.Data.OldConnectionStringProvider</id>
    <version>1.0.1</version>
    <title>Fanex.Data.OldConnectionStringProvider</title>
    <authors>jason.ly</authors>
